{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "novel-auto-publisher",
  "main": "src/nola-only.ts",
  "workers_dev": true,
  "compatibility_date": "2026-08-23",
  "compatibility_flags": ["nodejs_compat"],
  "browser": {
    "binding": "BROWSER"
  },
  "kv_namespaces": [
    {
      "binding": "SESSION_KV"
    }
  ]
}
